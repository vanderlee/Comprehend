services:
    -
        class: Vanderlee\Comprehend\Extensions\Extraction\MethodsExtension
        tags:
            - phpstan.broker.methodsClassReflectionExtension
    -
        class: Vanderlee\Comprehend\Extensions\Extraction\ValueTypeExtension
        tags:
            - phpstan.broker.dynamicMethodReturnTypeExtension
            - phpstan.broker.dynamicStaticMethodReturnTypeExtension
    -
        class: Vanderlee\Comprehend\Extensions\Extraction\ValueTypeExtension
        arguments:
            className: Vanderlee\Comprehend\Syntax
        tags:
            - phpstan.broker.dynamicMethodReturnTypeExtension
