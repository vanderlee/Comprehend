<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php" colors="true">
    <testsuites>
        <testsuite name="comprehend">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

