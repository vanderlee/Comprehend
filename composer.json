{
  "name": "vanderlee/comprehend",
  "description": "PHP parser combinators with ABNF authoring, immutable syntax trees and explicit effects",
  "type": "library",
  "keywords": ["parser", "parser-combinator", "abnf", "unicode", "cst", "ast"],
  "homepage": "https://github.com/vanderlee/Comprehend",
  "license": "MIT",
  "support": {
    "issues": "https://github.com/vanderlee/Comprehend/issues",
    "source": "https://github.com/vanderlee/Comprehend/"
  },
  "require": {
    "php": ">=8.1.0",
    "ext-json": "*",
    "ext-mbstring": "*"
  },
  "config": {
    "platform": {"php": "8.1.0"},
    "allow-plugins": {"pestphp/pest-plugin": true}
  },
  "suggest": {
    "ext-dom": "Required only for CST/AST XML serialization via toXml()."
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.1",
    "pestphp/pest": "^2.36",
    "phpmd/phpmd": "2.6.0",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Vanderlee\\Comprehend\\Extensions\\": "extensions/",
      "Vanderlee\\Comprehend\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  }
}
