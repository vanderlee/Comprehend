{
  "name": "vanderlee/comprehend",
  "description": "Interpreted parser-combinator framework with BNF-inspired grammar composition",
  "type": "library",
  "keywords": ["parser", "bnf", "abnf", "lexer", "tokenizer", "ast"],
  "homepage": "https://github.com/vanderlee/Comprehend",
  "license": "MIT",
  "support": {
    "issues": "https://github.com/vanderlee/Comprehend/issues",
    "source": "https://github.com/vanderlee/Comprehend/"
  },
  "require": {
    "php": ">=8.2.0",
    "ext-dom": "*",
    "ext-json": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "codacy/coverage": "dev-master",
    "phpunit/phpunit": "^9.6",
    "phpmd/phpmd": "2.6.0"
  },
  "autoload": {
    "files": ["src/Library/functions.php"],
    "psr-4": {
      "Vanderlee\\Comprehend\\": "src"
    }
  }
}
