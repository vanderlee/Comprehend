includes:
    - ../../phpstan-extension.neon
    - ../../extensions/Binding/phpstan.neon

parameters:
    level: 10
    phpVersion: 80100
    paths:
        - grammars.php
        - types.php
    scanFiles:
        - ../../docs/examples/application-values-grammar.php
    bootstrapFiles:
        - ../../build/binding/vendor/autoload.php
    tmpDir: ../../build/binding/phpstan
